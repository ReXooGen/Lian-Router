# LianRouter local environment template.
# Copy to .env for native development and replace placeholder secrets.
# Keep this file as a readable starting point: common runtime values come
# first, feature-specific overrides stay beside the feature they configure.
# Leave commented settings unset unless you intentionally need that behavior.

# Server and dashboard
# --------------------
PORT=12800
NODE_ENV=development
DASHBOARD_DIST=./dist/dashboard
# Required only for OAuth redirect flows. Local default:
# http://localhost:12800
LIANROUTER_PUBLIC_ORIGIN=http://localhost:12800

# Public base URL recipients should use to reach this gateway. Set it when the
# gateway sits behind a tunnel (cloudflared, ngrok) or a reverse proxy, so
# enrollment links and the /v1 address shown to recipients point at the public
# address instead of the loopback address the proxy dialed. Unset means the
# request origin is used, which is correct for a directly reachable gateway.
# Must be an absolute http(s) URL, e.g. https://router.example.com
# LIANROUTER_PUBLIC_BASE_URL=https://router.example.com

# cloudflared executable used by the console's Tunnel switch (Overview page).
# A bare name is resolved on PATH; an absolute path is used as-is, which is how
# an install outside PATH is pointed at without editing the machine PATH.
# Defaults to cloudflared on PATH. Example for a Windows install:
# LIANROUTER_CLOUDFLARED_BIN=C:\Program Files (x86)\cloudflared\cloudflared.exe
# LIANROUTER_CLOUDFLARED_BIN=cloudflared

# Optional version label surfaced by the health/telemetry endpoints. When
# omitted the running build reports an empty version.
# LIANROUTER_VERSION=0.0.0

# Logging
# -------
# One of trace, debug, info, warn, error, or fatal. Defaults to debug in
# development and info in production.
# LOG_LEVEL=info

# Database and application secrets
# ---------------------------------
# PostgreSQL may be local (Laragon/Homebrew/systemd) or external.
# In Docker, the hostname must be reachable from inside the app container.
DATABASE_URL=postgres://postgres:replace-with-local-password@localhost:5432/lianrouter

# LianRouter encryption key for provider credentials and API-key hashing.
# Use a random 32-byte value: openssl rand -base64 32
LIANROUTER_ENCRYPTION_KEY=replace-with-lianrouter-encryption-key

# Default local LianRouter API key. During first-boot setup it is hashed with
# LIANROUTER_ENCRYPTION_KEY and stored as a normal tenant-scoped API key.
LIANROUTER_API_KEY=replace-with-lianrouter-api-key

# Console password. When set, the console asks for this one password and
# nothing else — no username, no first-boot account wizard. This is the mode a
# single-operator local install wants. `local-console-2026` is the shipped
# default and the login screen prints it while it is still in use; set your own
# value and the hint disappears. Leave the variable unset to keep per-user
# accounts and the setup wizard.
#
# This is the INITIAL password: it can also be changed from the console
# (Settings -> Security Controls), which stores a hash and takes ownership, so
# a public deployment can set its own password without editing this file.
# Changing the value here and restarting reclaims ownership — that is also the
# recovery path if the console password is forgotten.
# LIANROUTER_CONSOLE_PASSWORD=local-console-2026

# Database pool and coordination
# ------------------------------
# Connections per gateway process, opened on demand (this is a ceiling, not a
# reservation). The proxy path issues no Postgres queries — routing is served
# from an in-process snapshot and admission counters live in Redis — so the
# database consumers are the console API, one telemetry flush, the worker
# sweeps, auth, and readiness. Keep DATABASE_POOL_MAX * (number of gateway
# processes) below the server's `max_connections` (Postgres defaults to 100);
# boot logs the process count that fits, and refuses a pool that alone exceeds
# the server ceiling.
# DATABASE_POOL_MAX=20
# normal       = Redis-backed coordination; REDIS_URL is required
# single_instance_local = bounded in-memory coordination; Redis is not needed
REDIS_MODE=normal
REDIS_URL=redis://localhost:6379

# Native-first setup
# ------------------
# PostgreSQL remains external in every mode. Docker is opt-in and only starts
# the Compose Redis helper.
LIANROUTER_SETUP_MODE=auto
# To use the Compose Redis helper explicitly, set LIANROUTER_SETUP_MODE=docker.

# Database and server safety overrides
# ------------------------------------
# Defaults are 30s, 60s, and 5s respectively.
# DATABASE_STATEMENT_TIMEOUT_MS=30000
# DATABASE_IDLE_IN_TXN_TIMEOUT_MS=60000
# DATABASE_LOCK_TIMEOUT_MS=5000
# Telemetry payload storage (off by default; request metadata remains in telemetry_events)
# ------------------------------------------------------------------------------------
# Explicitly opted-in payload bodies are stored in bounded local .jsonb frames.
# Retention defaults to 15 minutes and the cleanup scheduler runs every 15 minutes.
# LIANROUTER_TELEMETRY_PAYLOAD_DIR=./data/telemetry-payloads
# LIANROUTER_TELEMETRY_PAYLOAD_FILE_MAX_BYTES=67108864
# LIANROUTER_TELEMETRY_PAYLOAD_RETENTION_MS=900000
# Metadata-only request telemetry retention (default 30 days; usage periods up to 30d stay complete).
# Payload capture is off by default per tenant; opt in via Console Settings only when debugging.
# LIANROUTER_TELEMETRY_RETENTION_DAYS=30

# Defaults are 60s and 8 MiB respectively.
# LIANROUTER_SERVER_IDLE_TIMEOUT=60
# LIANROUTER_SERVER_MAX_BODY_BYTES=8388608

# Process memory limit used for the >80% usage warning on /metrics. Detected
# automatically from cgroup v1/v2 inside containers; set explicitly for native
# deployments that want the warning. When RSS exceeds 80% of it the sampler
# also runs an asynchronous garbage collection, at most once per minute.
# LIANROUTER_MEMORY_LIMIT_BYTES=536870912

# Bun garbage-collection tuning (optional; Bun already sizes the heap from
# available memory and cgroup limits).
# `--smol` makes the collector run more frequently to cap memory growth, at
# some CPU cost — useful in memory-constrained containers. BUN_OPTIONS is
# honored by the compiled binary as well as `bun run`.
# BUN_OPTIONS=--smol
# Force GC frequency: 0 = default, 1 = async GC more often, 2 = sync GC more
# often (aggressive; intended for debugging, not production).
# BUN_GARBAGE_COLLECTOR_LEVEL=1

# Per-IP gateway rate limit (requests per rolling window). Only enforced on
# /v1/*; defaults to 240 when unset.
# IP_RATE_MAX_PER_WINDOW=240

# Proxy and outbound SSRF policy
# -----------------------------
# When traffic arrives through cloudflared locally, trust its loopback peer:
# TRUSTED_PROXY_CIDRS=127.0.0.1/32,::1/128
# For Railway or another load balancer, set this to the ingress peer CIDRs.
# In trusted mode the gateway honors CF-Connecting-IP, True-Client-IP,
# X-Forwarded-For, then X-Real-IP; the raw peer is always used otherwise.
# Private upstreams are blocked by default. Do not enable this globally unless
# the deployment intentionally reaches private upstream networks.
# LIANROUTER_ALLOW_PRIVATE_UPSTREAMS=false
# LIANROUTER_ALLOWED_NETWORKS=10.0.0.0/8,192.168.0.0/16
# LIANROUTER_MAX_REDIRECTS=3

# Upstream request timeout and retry backoff
# ------------------------------------------
# Wall-clock bound for one proxied request, ingress to terminal upstream event,
# including candidate failover. Defaults to the previously hardcoded 120s. For
# a streaming response it bounds the pre-stream phase; once the body is
# established the deadline is re-armed to this value plus the stall budget, so
# the stream watchdogs below govern body duration.
# LIANROUTER_UPSTREAM_TIMEOUT_MS=120000
# Max silence between upstream stream events before the stream is declared
# stalled (504). Default 360s, above legitimate long reasoning silences. The
# pool-slot crash-recovery TTL is derived from this value plus the request
# deadline, so the watchdog releases the lease before the sweep can reclaim it.
# WARNING: the minimum is 60s, but Codex/o1-style hidden reasoning can hold
# ~5min silence. Lowering this toward the floor induces false 504s on
# legitimate reasoning turns; only lower it if no reasoning workload flows
# through this deployment.
# LIANROUTER_STREAM_STALL_TIMEOUT_MS=360000
# Max time to the first client-visible stream chunk (TTFB). Default 200s; after
# the first upstream activity (even surface-invisible reasoning deltas) the
# longer stall bound applies instead.
# LIANROUTER_STREAM_FIRST_CHUNK_TIMEOUT_MS=200000
# Candidate-failover backoff: full-jitter exponential between base and cap.
# LIANROUTER_FALLBACK_RETRY_BASE_MS=100
# LIANROUTER_FALLBACK_RETRY_CAP_MS=2000

# Account and proxy-pool health cooldowns
# --------------------------------------
# Fallback backoffs used only when the upstream error states no reset window;
# an upstream `Retry-After`/`x-ratelimit-reset` header or a duration quoted in
# the provider message always wins. Rate-limit and quota failures put the
# account in `cooldown`; transport-shaped failures (5xx, network, timeout,
# unclassified) put it in `degraded`. xAI Grok Build free-tier exhaustion is
# pinned to its rolling 24-hour window regardless of these values.
# LIANROUTER_ACCOUNT_RATE_LIMIT_COOLDOWN_MS=900000
# LIANROUTER_ACCOUNT_QUOTA_COOLDOWN_MS=3600000
# LIANROUTER_ACCOUNT_MODEL_CAPACITY_COOLDOWN_MS=120000
# LIANROUTER_ACCOUNT_TRANSIENT_COOLDOWN_MS=30000
# LIANROUTER_ACCOUNT_UNCLASSIFIED_COOLDOWN_MS=60000
# How long a proxy pool stays degraded/cooldown after a transport fault.
# LIANROUTER_POOL_COOLDOWN_MS=120000


# Provider OAuth hosts
# --------------------
# Override Kimi's OAuth origin for self-hosted or regional gateways.
# LIANROUTER_KIMI_OAUTH_HOST=https://auth.kimi.com
# Override the Kimi Code quota/billing base URL for regional gateways.
# LIANROUTER_KIMI_QUOTA_BASE_URL=https://api.kimi.com/coding/v1

# Upstream origin override for the bundled OpenCode Free provider (opencodeft).
# Unset keeps https://opencode.ai. Set it only when a local OpenCode CLI bridge
# fronts the free tier (its edge gate inspects the TLS ClientHello, which
# in-process HTTP clients cannot satisfy).
# LIANROUTER_OPENCODEFT_BASE_URL=http://127.0.0.1:8910

# Automation control plane (embedded GrokFarm WebUI proxy at /automation).
# Point at the loopback FastAPI service; unset hides the proxy and the sidebar
# entry. Must be a loopback host - the upstream itself must stay unauthenticated.
# LIANROUTER_AUTOMATION_UPSTREAM=http://127.0.0.1:8092

# Proxy pool agents
# -----------------
# HTTP(S) CONNECT and SOCKS5 agents share these socket limits. Pool egress is
# dialed in-process; there is no child-process pool flavor to configure.
# LIANROUTER_PROXY_MAX_SOCKETS=100
# LIANROUTER_PROXY_MAX_FREE_SOCKETS=20

# Dashboard development settings
# ------------------------------
# Vite defaults to http://127.0.0.1:12800 when this is unset.
# VITE_BACKEND_URL=http://127.0.0.1:12800

# Launcher (`cli/`) only — not read by the gateway
# ------------------------------------------------
# These belong to the globally installed `lianrouter` command, not to the
# gateway process. They live in `cli/`, outside `src/`, so the environment
# drift test never scans them; they are documented here because this file is
# the one configuration reference an operator reads.
#
# Install/state root for the launcher: the compiled gateway binary,
# `migrations/`, `dist/dashboard/`, `logs/`, `cache/`, and `run/` all live
# here. Unset uses the per-OS app-data folder (`%LOCALAPPDATA%\LianRouter`,
# `~/Library/Application Support/LianRouter`, or `$XDG_DATA_HOME/LianRouter`).
# A relative value is resolved against the working directory once, at startup.
# LIANROUTER_HOME=C:\LianRouter

# Release feed the launcher's self-update reads. Unset uses the project's
# GitHub releases endpoint. Read once at process start, so the version check
# and the download cannot disagree about which host is authoritative.
# LIANROUTER_UPDATE_BASE_URL=https://api.github.com/repos/OWNER/REPO/releases

# Install root of the launcher that started this gateway. INJECTED BY THE
# LAUNCHER — do not set it by hand. The gateway reads
# `<root>/run/control.json` to reach the launcher's loopback control plane,
# which is what makes "an update is available" and "install it" work in the
# console; the launcher owns the binary and is the only process allowed to
# replace it. Unset means no launcher is attached and the console reports
# updates as unavailable.
# LIANROUTER_LAUNCHER_HOME=C:\LianRouter


# Isolated test database
# ----------------------
# Gates the DB-dependent suites AND routes them at this database, so test
# fixtures never land in DATABASE_URL. Leave unset to skip those suites.
# LIANROUTER_TEST_DATABASE_URL=postgres://postgres:replace-with-local-password@localhost:5432/lianrouter_test
