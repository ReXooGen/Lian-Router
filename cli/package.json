{
  "name": "lianrouter",
  "version": "2.0.0",
  "description": "LianRouter launcher: install, run and control the gateway from one command",
  "type": "module",
  "bin": {
    "lianrouter": "./dist/cli.js"
  },
  "engines": {
    "bun": ">=1.4.2"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "bun run ../scripts/build-cli.ts",
    "typecheck": "tsc --noEmit -p .",
    "postinstall": "echo lianrouter: the gateway binary installs on first run, not during this install",
    "prepublishOnly": "bun run build"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ReXooGen/Lian-Router.git",
    "directory": "cli"
  },
  "bugs": {
    "url": "https://github.com/ReXooGen/Lian-Router/issues"
  },
  "homepage": "https://github.com/ReXooGen/Lian-Router#readme",
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "lianrouter",
    "ai-gateway",
    "openai-compatible",
    "llm-router",
    "self-hosted",
    "cli",
    "launcher"
  ]
}
